{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D01 public_turn",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "turn_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+-s[0-9]{3}-t[0-9]{3}$"
    },
    "session_index": {
      "type": "integer",
      "minimum": 0
    },
    "session_date": {
      "type": "string"
    },
    "session_datetime": {
      "type": "string"
    },
    "sort_key": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "role",
          "content"
        ]
      }
    }
  },
  "required": [
    "turn_id",
    "session_index",
    "session_date",
    "session_datetime",
    "sort_key",
    "messages"
  ]
}
