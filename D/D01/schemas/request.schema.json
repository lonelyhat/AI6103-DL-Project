{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D01 request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "question": {
      "type": "string"
    },
    "question_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "enum": [
        "dev",
        "formal"
      ]
    },
    "index": {
      "enum": [
        "K0",
        "K1"
      ]
    },
    "strategy": {
      "enum": [
        null,
        "R",
        "MMR",
        "C",
        "Q",
        "FL"
      ]
    },
    "budget_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "tokenizer": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turn_id": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number"
          }
        },
        "required": [
          "turn_id",
          "rank",
          "score"
        ]
      }
    }
  },
  "required": [
    "question_id",
    "question",
    "stage",
    "index",
    "budget_tokens",
    "candidates"
  ]
}
